# Shared Azure OpenAI resource. These values are used as fallbacks by the
# GPT image and vision clients.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_API_KEY=YOUR_KEY

# GPT image generation
AZURE_GPT_IMAGE_DEPLOYMENT=gpt-image-2
AZURE_GPT_IMAGE_SIZE=1536x1024
# AZURE_GPT_IMAGE_ENDPOINT=https://YOUR-IMAGE-RESOURCE.openai.azure.com
# AZURE_GPT_IMAGE_API_KEY=YOUR_IMAGE_KEY

# MAI image generation (optional). MAI requires a Foundry resource endpoint.
# AZURE_MAI_IMAGE_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com
# AZURE_MAI_IMAGE_API_KEY=YOUR_MAI_KEY
# AZURE_MAI_IMAGE_DEPLOYMENT=MAI-Image-2.5
# AZURE_MAI_IMAGE_SIZE=1024x1024

# Vision model used to locate diagram parts
AZURE_VISION_DEPLOYMENT=gpt-5.6-terra
# AZURE_VISION_ENDPOINT=https://YOUR-VISION-RESOURCE.openai.azure.com
# AZURE_VISION_API_KEY=YOUR_VISION_KEY
# Use chat-completions only when the deployment does not support Responses API.
# AZURE_VISION_API=chat-completions

# Optional request tuning
AZURE_IMAGE_QUALITY=medium
AZURE_REQUEST_TIMEOUT_MS=180000

# Application database and authentication
DATABASE_URL=file:./dev.db
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
AUTH_URL=http://localhost:3000

# Optional social login providers. Providers with incomplete credentials are
# omitted from the sign-in screen rather than failing application startup.
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_FACEBOOK_ID=
# AUTH_FACEBOOK_SECRET=

# Figure image storage: local (default) or azure
FIGURE_STORAGE=local
FIGURE_STORAGE_DIR=./.media
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_ACCOUNT=
# AZURE_STORAGE_KEY=
# AZURE_STORAGE_CONTAINER=figures
