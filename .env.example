# This is the application's single configuration source. Copy to .env.
# .env.local, mode-specific env files and inherited application settings are ignored.
# Restart the server after changing configuration.

# Azure OpenAI resource used by the vision client.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_API_KEY=YOUR_KEY
# auto uses a key first and switches to Microsoft Entra ID if keys are disabled.
# entra uses DefaultAzureCredential (managed identity, workload identity, or az login).
# AZURE_AUTH_MODE=auto

# Image registry: configure each deployment and endpoint explicitly.
# Each entry needs id, label, api (openai or mai), endpoint and deployment.
# apiKeyEnv references a separate secret variable; never put keys in the JSON.
# Optional per-entry settings: authMode, size, quality, timeoutMs.
AZURE_IMAGE_MODELS='[{"id":"primary","label":"Primary image","api":"openai","endpoint":"https://YOUR-IMAGE-RESOURCE.openai.azure.com","deployment":"YOUR_IMAGE_DEPLOYMENT","apiKeyEnv":"AZURE_IMAGE_PRIMARY_KEY"}]'
AZURE_IMAGE_PRIMARY_KEY=YOUR_IMAGE_KEY
# Add more OpenAI or MAI entries to the array for other resources/deployments:
# {"id":"detail","label":"Detailed image","api":"openai","endpoint":"https://IMAGE-B.openai.azure.com","deployment":"YOUR_DETAIL_DEPLOYMENT","apiKeyEnv":"AZURE_IMAGE_DETAIL_KEY","quality":"high"}
# {"id":"editorial","label":"MAI editorial","api":"mai","endpoint":"https://IMAGE-C.services.ai.azure.com","deployment":"YOUR_MAI_DEPLOYMENT","apiKeyEnv":"AZURE_IMAGE_MAI_KEY"}
# AZURE_IMAGE_DETAIL_KEY=YOUR_IMAGE_B_KEY
# AZURE_IMAGE_MAI_KEY=YOUR_IMAGE_C_KEY

# Default image model ID in the studio and demo generator: use an entry's id.
# Defaults to the first configured model.
AZURE_IMAGE_MODEL=primary

# Vision deployment used for both planning and locating diagram parts
AZURE_VISION_DEPLOYMENT=gpt-5.6-terra
# AZURE_VISION_ENDPOINT=https://YOUR-VISION-RESOURCE.openai.azure.com
# AZURE_VISION_API_KEY=YOUR_VISION_KEY
# Optional resource-specific authentication override:
# AZURE_VISION_AUTH_MODE=api-key
# AZURE_VISION_TIMEOUT_MS=180000
# Use chat-completions only when the deployment does not support Responses API.
# AZURE_VISION_API=chat-completions

# Optional request tuning
# Quality: low, medium, high, auto. Timeout: 10000-300000 milliseconds.
AZURE_IMAGE_QUALITY=medium
AZURE_REQUEST_TIMEOUT_MS=180000

# Application database and authentication
DATABASE_URL=file:./dev.db
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
AUTH_URL=http://localhost:3000

# Optional social login providers. Providers with incomplete credentials are
# omitted from the sign-in screen rather than failing application startup.
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_FACEBOOK_ID=
# AUTH_FACEBOOK_SECRET=

# Figure image storage: local (default) or azure
FIGURE_STORAGE=local
FIGURE_STORAGE_DIR=./.media
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_ACCOUNT=
# AZURE_STORAGE_KEY=
# AZURE_STORAGE_CONTAINER=figures
