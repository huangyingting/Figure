generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String?        @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  credits       Int            @default(12)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  accounts      Account[]
  figures       Figure[]
  collections   Collection[]
  quizAttempts  QuizAttempt[]
  creditLedger  CreditLedger[]
  favorites     Favorite[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Figure {
  id             String             @id @default(cuid())
  ownerId        String
  title          String
  subject        String
  summary        String
  imageKey       String
  imageMimeType  String
  imageWidth     Int
  imageHeight    Int
  imageModel     String
  visionModel    String
  annotationJson String
  diagramType    String?
  audience       String?
  isPublic       Boolean            @default(false)
  viewCount      Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  owner          User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  collections    CollectionFigure[]
  quizAttempts   QuizAttempt[]
  favorites      Favorite[]
  revisions      AnnotationRevision[]

  @@index([ownerId, createdAt])
  @@index([isPublic, createdAt])
}

// Snapshot of the annotation layer after every meaningful change (initial AI
// draft, each human edit, each restore), so a bad save is never destructive.
model AnnotationRevision {
  id             String   @id @default(cuid())
  figureId       String
  annotationJson String
  source         String // "ai-draft" | "human-edit" | "restore"
  createdAt      DateTime @default(now())
  figure         Figure   @relation(fields: [figureId], references: [id], onDelete: Cascade)

  @@index([figureId, createdAt])
}

model Collection {
  id          String             @id @default(cuid())
  ownerId     String
  name        String
  description String?
  color       String             @default("violet")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  owner       User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  figures     CollectionFigure[]

  @@unique([ownerId, name])
  @@index([ownerId, updatedAt])
}

model CollectionFigure {
  collectionId String
  figureId     String
  addedAt      DateTime   @default(now())
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  figure       Figure     @relation(fields: [figureId], references: [id], onDelete: Cascade)

  @@id([collectionId, figureId])
  @@index([figureId])
}

model QuizAttempt {
  id          String       @id @default(cuid())
  userId      String
  figureId    String
  score       Int
  total       Int
  completedAt DateTime     @default(now())
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  figure      Figure       @relation(fields: [figureId], references: [id], onDelete: Cascade)
  answers     QuizAnswer[]

  @@index([userId, completedAt])
  @@index([figureId])
}

// One row per answered component, so per-part accuracy is queryable.
// userId/figureId are denormalized copies of the attempt's columns: Prisma's
// groupBy cannot traverse relations, and "weakest components for this user on
// this figure" is the query this table exists to serve.
model QuizAnswer {
  attemptId String
  userId    String
  figureId  String
  partId    String
  answer    String
  correct   Boolean
  attempt   QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@id([attemptId, partId])
  @@index([userId, figureId, partId])
}

model CreditLedger {
  id          String   @id @default(cuid())
  userId      String
  amount      Int
  balance     Int
  reason      String
  referenceId String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Favorite {
  userId    String
  figureId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  figure    Figure   @relation(fields: [figureId], references: [id], onDelete: Cascade)

  @@id([userId, figureId])
  @@index([userId, createdAt])
  @@index([figureId])
}
