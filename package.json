    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@prisma/client": "^6.19.2",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "16.2.12",
    "next-auth": "^5.0.0-beta.32",
    "openai": "7.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.2.12",
