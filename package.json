{
  "name": "figure-learning-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "node scripts/prisma.mjs generate",
    "db:migrate": "node scripts/prisma.mjs migrate dev",
    "db:deploy": "node scripts/prisma.mjs migrate deploy",
    "db:push": "node scripts/prisma.mjs db push",
    "db:seed": "tsx prisma/seed.ts",
    "setup:local": "node scripts/setup-local.mjs",
    "credits:recover": "tsx scripts/recover-generation-credit.ts",
    "demo:generate": "tsx scripts/generate-demo-pump.ts",
    "azure:check": "tsx scripts/check-azure.ts",
    "check": "npm run db:generate && npm run test && npm run typecheck && npm run lint && npm run build"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@azure/identity": "4.13.0",
    "@azure/storage-blob": "^12.28.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@prisma/client": "6.19.2",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "dotenv": "16.6.1",
    "lucide-react": "^0.468.0",
    "next": "^16.4.3",
    "next-auth": "^5.0.0-beta.32",
    "openai": "7.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.2.12",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prisma": "6.19.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.5",
    "effect": "3.20.0",
    "@prisma/config": {
      "deepmerge-ts": "8.0.0"
    },
    "@azure/msal-node": {
      "uuid": "11.1.1"
    }
  },
  "engines": {
    "node": ">=20.9"
  },
  "allowScripts": {
    "@prisma/client@6.19.2": true,
    "@prisma/engines@6.19.2": true,
    "esbuild@0.28.1": true,
    "prisma@6.19.2": true
  }
}
